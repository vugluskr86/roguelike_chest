{
  "name": "chess-roguelike",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Шахматный рогалик — фигура-игрок меняет форму, спускаясь по процедурным этажам.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ test/",
    "lint:fix": "eslint src/ test/ --fix",
    "format": "prettier --check src/ test/",
    "format:fix": "prettier --write src/ test/",
    "deploy": "npm run build && git add docs/ && git commit -m \"Deploy to GitHub Pages\" && git push",
    "electron:dev": "vite & sleep 2 && electron .",
    "electron:build": "vite build && rimraf dist-electron && electron-builder",
    "android:init": "npx cap init && npx cap add android",
    "android:sync": "npm run build && npx cap sync",
    "android:open": "npx cap open android"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "com.endgame.chessroguelike",
    "productName": "Эндшпиль",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^24.1.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
