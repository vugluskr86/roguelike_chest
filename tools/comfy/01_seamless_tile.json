{
  "_meta_note": "Бесшовный тайл пола/стены. Asymmetric Tiling обе оси. Плейсхолдеры: ckpt, prompt, name, seed, tile_px.",
  "m_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{ckpt}}"
    }
  },
  "p_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}, pixel art, 16-bit, limited palette, bone white and rust iron and deep teal and crimson, dark dungeon under a chessboard, grim, hand-crafted tileset, crisp pixels, no antialiasing, seamless repeating texture, top-down orthographic, flat even lighting, no objects, no shadows cast outside the tile",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "p_neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, jpeg artifacts, photo, 3d render, smooth gradient, antialiasing, text, watermark, signature, logo, frame, border, vignette, depth of field, bokeh, human hands, modern",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "latent": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "sampler": {
    "class_type": "Asymmetric_Tiling_KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 28,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "latent",
        0
      ],
      "denoise": 1.0,
      "step_range": 0,
      "tileX": "enable",
      "tileY": "enable"
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "save_hires": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decode",
        0
      ],
      "filename_prefix": "endshpil/tiles_src/{{name}}"
    }
  },
  "pixel": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "decode",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{tile_px}}",
      "height": "{{tile_px}}",
      "crop": "disabled"
    }
  },
  "save_tile": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "pixel",
        0
      ],
      "filename_prefix": "endshpil/tiles/{{name}}"
    }
  }
}