{
  "_meta_note": "Карточный/лорный арт под ваш текущий формат 512×768. Плейсхолдеры: ckpt, prompt, name, seed, upscale_model (напр. 4x_foolhardy_Remacri.pth).",
  "m_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{ckpt}}"
    }
  },
  "p_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}, pixel art, 16-bit, limited palette, bone white and rust iron and deep teal and crimson, dark dungeon under a chessboard, grim, hand-crafted tileset, crisp pixels, no antialiasing, illustrated card art, dark chunky border frame, vertical composition, dramatic single subject",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "p_neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, jpeg artifacts, photo, 3d render, smooth gradient, antialiasing, text, watermark, signature, logo, frame, border, vignette, depth of field, bokeh, human hands, modern",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "td": {
    "class_type": "TiledDiffusion",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "method": "Mixture of Diffusers",
      "tile_width": 1024,
      "tile_height": 1024,
      "tile_overlap": 128,
      "tile_batch_size": 2
    }
  },
  "lat": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "td",
        0
      ],
      "seed": "{{seed}}",
      "steps": 30,
      "cfg": 6.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "lat",
        0
      ],
      "denoise": 1.0
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "upmodel": {
    "class_type": "UpscaleModelLoader",
    "inputs": {
      "model_name": "{{upscale_model}}"
    }
  },
  "usdu": {
    "class_type": "UltimateSDUpscale",
    "inputs": {
      "image": [
        "dec",
        0
      ],
      "model": [
        "m_ckpt",
        0
      ],
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ],
      "upscale_by": 2.0,
      "seed": "{{seed}}",
      "steps": 18,
      "cfg": 5.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "denoise": 0.28,
      "upscale_model": [
        "upmodel",
        0
      ],
      "mode_type": "Linear",
      "tile_width": 768,
      "tile_height": 768,
      "mask_blur": 16,
      "tile_padding": 48,
      "seam_fix_mode": "Half Tile",
      "seam_fix_denoise": 0.35,
      "seam_fix_width": 64,
      "seam_fix_mask_blur": 16,
      "seam_fix_padding": 32,
      "force_uniform_tiles": true,
      "tiled_decode": false
    }
  },
  "down": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "usdu",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": 512,
      "height": 768,
      "crop": "center"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "down",
        0
      ],
      "filename_prefix": "endshpil/art/{{name}}"
    }
  }
}