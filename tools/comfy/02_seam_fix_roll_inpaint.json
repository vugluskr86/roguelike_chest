{
  "_meta_note": "Делает бесшовным ЛЮБОЙ квадратный 1024 PNG. Только ядровые ноды. Плейсхолдеры: ckpt, image, prompt, seed, denoise(0.45-0.65), tile_px, name.",
  "m_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{ckpt}}"
    }
  },
  "p_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}, pixel art, 16-bit, limited palette, bone white and rust iron and deep teal and crimson, dark dungeon under a chessboard, grim, hand-crafted tileset, crisp pixels, no antialiasing, seamless texture, continuous surface",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "p_neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, jpeg artifacts, photo, 3d render, smooth gradient, antialiasing, text, watermark, signature, logo, frame, border, vignette, depth of field, bokeh, human hands, modern",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "src": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    }
  },
  "cx_l": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "src",
        0
      ],
      "width": 512,
      "height": 1024,
      "x": 0,
      "y": 0
    }
  },
  "cx_r": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "src",
        0
      ],
      "width": 512,
      "height": 1024,
      "x": 512,
      "y": 0
    }
  },
  "rollx": {
    "class_type": "ImageStitch",
    "inputs": {
      "image1": [
        "cx_r",
        0
      ],
      "image2": [
        "cx_l",
        0
      ],
      "direction": "right",
      "match_image_size": false,
      "spacing_width": 0,
      "spacing_color": "white"
    }
  },
  "cy_t": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "rollx",
        0
      ],
      "width": 1024,
      "height": 512,
      "x": 0,
      "y": 0
    }
  },
  "cy_b": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "rollx",
        0
      ],
      "width": 1024,
      "height": 512,
      "x": 0,
      "y": 512
    }
  },
  "rolled": {
    "class_type": "ImageStitch",
    "inputs": {
      "image1": [
        "cy_b",
        0
      ],
      "image2": [
        "cy_t",
        0
      ],
      "direction": "down",
      "match_image_size": false,
      "spacing_width": 0,
      "spacing_color": "white"
    }
  },
  "m_zero": {
    "class_type": "SolidMask",
    "inputs": {
      "value": 0.0,
      "width": 1024,
      "height": 1024
    }
  },
  "m_v": {
    "class_type": "SolidMask",
    "inputs": {
      "value": 1.0,
      "width": 192,
      "height": 1024
    }
  },
  "m_h": {
    "class_type": "SolidMask",
    "inputs": {
      "value": 1.0,
      "width": 1024,
      "height": 192
    }
  },
  "m1": {
    "class_type": "MaskComposite",
    "inputs": {
      "destination": [
        "m_zero",
        0
      ],
      "source": [
        "m_v",
        0
      ],
      "x": 416,
      "y": 0,
      "operation": "add"
    }
  },
  "m2": {
    "class_type": "MaskComposite",
    "inputs": {
      "destination": [
        "m1",
        0
      ],
      "source": [
        "m_h",
        0
      ],
      "x": 0,
      "y": 416,
      "operation": "add"
    }
  },
  "mask": {
    "class_type": "FeatherMask",
    "inputs": {
      "mask": [
        "m2",
        0
      ],
      "left": 24,
      "top": 24,
      "right": 24,
      "bottom": 24
    }
  },
  "enc": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "rolled",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "noise_mask": {
    "class_type": "SetLatentNoiseMask",
    "inputs": {
      "samples": [
        "enc",
        0
      ],
      "mask": [
        "mask",
        0
      ]
    }
  },
  "ks": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 24,
      "cfg": 5.5,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "noise_mask",
        0
      ],
      "denoise": "{{denoise}}"
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "bx_l": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "dec",
        0
      ],
      "width": 512,
      "height": 1024,
      "x": 0,
      "y": 0
    }
  },
  "bx_r": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "dec",
        0
      ],
      "width": 512,
      "height": 1024,
      "x": 512,
      "y": 0
    }
  },
  "backx": {
    "class_type": "ImageStitch",
    "inputs": {
      "image1": [
        "bx_r",
        0
      ],
      "image2": [
        "bx_l",
        0
      ],
      "direction": "right",
      "match_image_size": false,
      "spacing_width": 0,
      "spacing_color": "white"
    }
  },
  "by_t": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "backx",
        0
      ],
      "width": 1024,
      "height": 512,
      "x": 0,
      "y": 0
    }
  },
  "by_b": {
    "class_type": "ImageCrop",
    "inputs": {
      "image": [
        "backx",
        0
      ],
      "width": 1024,
      "height": 512,
      "x": 0,
      "y": 512
    }
  },
  "back": {
    "class_type": "ImageStitch",
    "inputs": {
      "image1": [
        "by_b",
        0
      ],
      "image2": [
        "by_t",
        0
      ],
      "direction": "down",
      "match_image_size": false,
      "spacing_width": 0,
      "spacing_color": "white"
    }
  },
  "pixel": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "back",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{tile_px}}",
      "height": "{{tile_px}}",
      "crop": "disabled"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "pixel",
        0
      ],
      "filename_prefix": "endshpil/tiles/{{name}}"
    }
  },
  "save_hires": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "back",
        0
      ],
      "filename_prefix": "endshpil/tiles_src/{{name}}"
    }
  }
}