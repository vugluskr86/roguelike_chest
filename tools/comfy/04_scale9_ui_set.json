{
  "_meta_note": "4 куска scale9: corner / edge_h (tileX) / edge_v (tileY) / fill. Сборку листа и border-image делает tools/slice9.py. Плейсхолдеры: ckpt, prompt, fill_prompt, name, seed, corner_px(24-48), edge_len_px(64-128).",
  "m_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{ckpt}}"
    }
  },
  "p_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}, pixel art, 16-bit, limited palette, bone white and rust iron and deep teal and crimson, dark dungeon under a chessboard, grim, hand-crafted tileset, crisp pixels, no antialiasing, carved stone and bone UI frame element, ornamental border, flat orthographic, straight edges, plain dark inner area",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "p_neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, jpeg artifacts, photo, 3d render, smooth gradient, antialiasing, text, watermark, signature, logo, frame, border, vignette, depth of field, bokeh, human hands, modern",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "lat_c": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "ks_c": {
    "class_type": "Asymmetric_Tiling_KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 26,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "lat_c",
        0
      ],
      "denoise": 1.0,
      "step_range": 0,
      "tileX": "disable",
      "tileY": "disable"
    }
  },
  "dec_c": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks_c",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "px_c": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "dec_c",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{corner_px}}",
      "height": "{{corner_px}}",
      "crop": "disabled"
    }
  },
  "save_c": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "px_c",
        0
      ],
      "filename_prefix": "endshpil/ui/{{name}}_corner"
    }
  },
  "lat_h": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 256,
      "batch_size": 1
    }
  },
  "ks_h": {
    "class_type": "Asymmetric_Tiling_KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 26,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "lat_h",
        0
      ],
      "denoise": 1.0,
      "step_range": 0,
      "tileX": "enable",
      "tileY": "disable"
    }
  },
  "dec_h": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks_h",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "px_h": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "dec_h",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{edge_len_px}}",
      "height": "{{corner_px}}",
      "crop": "disabled"
    }
  },
  "save_h": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "px_h",
        0
      ],
      "filename_prefix": "endshpil/ui/{{name}}_edge_h"
    }
  },
  "lat_v": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 256,
      "height": 1024,
      "batch_size": 1
    }
  },
  "ks_v": {
    "class_type": "Asymmetric_Tiling_KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 26,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "lat_v",
        0
      ],
      "denoise": 1.0,
      "step_range": 0,
      "tileX": "disable",
      "tileY": "enable"
    }
  },
  "dec_v": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks_v",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "px_v": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "dec_v",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{corner_px}}",
      "height": "{{edge_len_px}}",
      "crop": "disabled"
    }
  },
  "save_v": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "px_v",
        0
      ],
      "filename_prefix": "endshpil/ui/{{name}}_edge_v"
    }
  },
  "lat_f": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 512,
      "height": 512,
      "batch_size": 1
    }
  },
  "pf": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "m_ckpt",
        1
      ],
      "text": "{{fill_prompt}}, pixel art, 16-bit, limited palette, bone white and rust iron and deep teal and crimson, dark dungeon under a chessboard, grim, hand-crafted tileset, crisp pixels, no antialiasing, seamless dark parchment / stone surface, very low contrast, no ornament, flat"
    }
  },
  "ks_f": {
    "class_type": "Asymmetric_Tiling_KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 20,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "pf",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "latent_image": [
        "lat_f",
        0
      ],
      "denoise": 1.0,
      "step_range": 0,
      "tileX": "enable",
      "tileY": "enable"
    }
  },
  "dec_f": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "ks_f",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "px_f": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "dec_f",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{corner_px}}",
      "height": "{{corner_px}}",
      "crop": "disabled"
    }
  },
  "save_f": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "px_f",
        0
      ],
      "filename_prefix": "endshpil/ui/{{name}}_fill"
    }
  }
}