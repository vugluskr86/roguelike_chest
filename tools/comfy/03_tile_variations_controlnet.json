{
  "_meta_note": "Вариации от базового тайла (ControlNet Tile + Asymmetric Tiling). denoise 0.45-0.75 = сила отхода. Плейсхолдеры: ckpt, image, controlnet, prompt, cn_strength(0.6-0.9), cn_end(0.7-1.0), denoise, tile_px, name, seed.",
  "m_ckpt": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "{{ckpt}}"
    }
  },
  "p_pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}, pixel art, 16-bit, limited palette, bone white and rust iron and deep teal and crimson, dark dungeon under a chessboard, grim, hand-crafted tileset, crisp pixels, no antialiasing, seamless repeating texture",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "p_neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "blurry, jpeg artifacts, photo, 3d render, smooth gradient, antialiasing, text, watermark, signature, logo, frame, border, vignette, depth of field, bokeh, human hands, modern",
      "clip": [
        "m_ckpt",
        1
      ]
    }
  },
  "src": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{image}}"
    }
  },
  "cn": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "{{controlnet}}"
    }
  },
  "cn_apply": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": [
        "p_pos",
        0
      ],
      "negative": [
        "p_neg",
        0
      ],
      "control_net": [
        "cn",
        0
      ],
      "image": [
        "src",
        0
      ],
      "strength": "{{cn_strength}}",
      "start_percent": 0.0,
      "end_percent": "{{cn_end}}"
    }
  },
  "enc": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": [
        "src",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "sampler": {
    "class_type": "Asymmetric_Tiling_KSampler",
    "inputs": {
      "model": [
        "m_ckpt",
        0
      ],
      "seed": "{{seed}}",
      "steps": 24,
      "cfg": 6.0,
      "sampler_name": "dpmpp_2m",
      "scheduler": "karras",
      "positive": [
        "cn_apply",
        0
      ],
      "negative": [
        "cn_apply",
        1
      ],
      "latent_image": [
        "enc",
        0
      ],
      "denoise": "{{denoise}}",
      "step_range": 0,
      "tileX": "enable",
      "tileY": "enable"
    }
  },
  "dec": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "m_ckpt",
        2
      ]
    }
  },
  "pixel": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "dec",
        0
      ],
      "upscale_method": "nearest-exact",
      "width": "{{tile_px}}",
      "height": "{{tile_px}}",
      "crop": "disabled"
    }
  },
  "save": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "pixel",
        0
      ],
      "filename_prefix": "endshpil/tiles/{{name}}"
    }
  }
}